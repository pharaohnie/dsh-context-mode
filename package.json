{
  "name": "dsh-context-mode",
  "version": "0.1.0",
  "description": "DSH context-window relief: knowledge base (ctx_index/search), routing enforcement (deny flood tools), and session continuity (post-compaction restore).",
  "type": "module",
  "main": "./src/index.ts",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "knowledge-base",
    "fts5",
    "plugin"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "cordis.patch.yml",
    "relink-dsh-context-mode.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
