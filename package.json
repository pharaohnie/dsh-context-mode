{
  "name": "dsh-context-mode",
  "version": "0.1.0",
  "description": "DSH context-window relief: knowledge base (ctx_index/search), routing enforcement (deny flood tools), sandboxed execution (ctx_execute/batch Think-in-Code), and session continuity (post-compaction restore).",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json && node scripts/smoke.ts"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "knowledge-base",
    "fts5",
    "sandbox",
    "code-execution",
    "plugin"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "relink-dsh-context-mode.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "turndown": "7.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
